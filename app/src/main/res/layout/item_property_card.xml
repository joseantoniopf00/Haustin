<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardCornerRadius="16dp"
    app:cardElevation="8dp"
    android:layout_margin="8dp">

    <!-- ELIMINADO EL SCROLLVIEW - Ahora todo el contenido es directamente arrastrable -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#1c3a5c"
        android:padding="16dp">

        <!-- Imagen de la casa - TAMAÑO OPTIMIZADO -->
        <ImageView
            android:id="@+id/imageViewCasa"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:src="@drawable/casa_ejemplo"
            android:scaleType="centerCrop"
            android:contentDescription="Imagen de la casa"
            android:layout_marginBottom="12dp" />

        <!-- Contenedor horizontal para precio y ciudad -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical">

            <!-- Precio -->
            <TextView
                android:id="@+id/priceTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="1.200€/mes"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- Recuadro naranja para ciudad -->
            <TextView
                android:id="@+id/cityTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ciudad"
                android:background="#FF9800"
                android:textColor="#212121"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Contenedor para características - MÁS COMPACTO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <!-- Característica 1 -->
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Familias"
                android:background="#80FF9800"
                android:textColor="#FFFFFF"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:textSize="11sp"
                android:gravity="center"
                android:layout_marginEnd="4dp" />

            <!-- Característica 2 -->
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Trabajar"
                android:background="#80FF9800"
                android:textColor="#FFFFFF"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:textSize="11sp"
                android:gravity="center"
                android:layout_marginEnd="4dp"
                android:layout_marginStart="4dp" />

            <!-- Característica 3 -->
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Vistas"
                android:background="#80FF9800"
                android:textColor="#FFFFFF"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:textSize="11sp"
                android:gravity="center"
                android:layout_marginStart="4dp" />

        </LinearLayout>

        <!-- Texto de habitaciones y metros -->
        <TextView
            android:id="@+id/roomsTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="3 hab · 80m²"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center" />

    </LinearLayout>

</androidx.cardview.widget.CardView>