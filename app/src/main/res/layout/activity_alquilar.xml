<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0f2540"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Título principal -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Haustin"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <!-- Subtítulo -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Te recomendamos esta casa por tu estilo de vida"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- Imagen de la casa -->
        <ImageView
            android:id="@+id/imageViewCasa"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:src="@drawable/casa_ejemplo"
        android:scaleType="centerCrop"
        android:contentDescription="Imagen de la casa"
        android:layout_marginBottom="16dp" />

        <!-- Contenedor horizontal para precio y ciudad -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <!-- Precio -->
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="1.200$/mes"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />

            <!-- Recuadro naranja para ciudad -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ciudad"
                android:background="#FF9800"
                android:textColor="#212121"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Contenedor para las tres características -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <!-- Característica 1 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Perfecto para familias"
                android:background="#80FF9800"
            android:textColor="#FFFFFF"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

            <!-- Característica 2 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ideal para trabajar"
                android:background="#80FF9800"
                android:textColor="#FFFFFF"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:textSize="14sp"
                android:layout_marginBottom="8dp" />

            <!-- Característica 3 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Vistas espectaculares"
                android:background="#80FF9800"
                android:textColor="#FFFFFF"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- Texto de habitaciones y metros -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="3 hab y 80m"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginBottom="24dp" />

        <!-- Contenedor horizontal para los botones -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginBottom="16dp">


            <Button
                android:id="@+id/btnPasar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Pasar"
                android:background="#FFFFFF"
                android:textColor="#0f2540"
                android:layout_marginEnd="8dp"
                android:textStyle="bold" />


            <Button
                android:id="@+id/btnMeInteresa"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Me interesa"
                android:background="#FF9800"
                android:textColor="#212121"
                android:layout_marginStart="8dp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>