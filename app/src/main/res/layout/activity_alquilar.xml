<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0f2540"
    android:padding="16dp">

    <!-- Título principal -->
    <TextView
        android:id="@+id/titleTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Haustin"
        android:textColor="#FFFFFF"
        android:textSize="32sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <!-- Subtítulo -->
    <TextView
        android:id="@+id/subtitleTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Arrastra las propiedades hacia los lados"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:gravity="center"
        android:layout_below="@id/titleTextView"
        android:layout_marginBottom="16dp" />

    <!-- Contenedor para la tarjeta - AHORA SIN RESTRICCIONES DE SCROLL -->
    <FrameLayout
        android:id="@+id/cardContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_below="@id/subtitleTextView"
        android:layout_above="@+id/buttonsLayout"
        android:layout_marginBottom="24dp" />

    <!-- Overlay para "Me interesa" (derecha) -->
    <TextView
        android:id="@+id/likeOverlay"
        android:layout_width="200dp"
        android:layout_height="80dp"
        android:text="ME INTERESA"
        android:textColor="#4CAF50"
        android:textSize="32sp"
        android:textStyle="bold"
        android:gravity="center"
        android:background="#804CAF50"
        android:visibility="invisible"
        android:layout_centerInParent="true"
        android:rotation="15" />

    <!-- Overlay para "Pasar" (izquierda) -->
    <TextView
        android:id="@+id/passOverlay"
        android:layout_width="200dp"
        android:layout_height="80dp"
        android:text="PASAR"
        android:textColor="#F44336"
        android:textSize="32sp"
        android:textStyle="bold"
        android:gravity="center"
        android:background="#80F44336"
        android:visibility="invisible"
        android:layout_centerInParent="true"
        android:rotation="-15" />

    <!-- Botones de acción -->
    <LinearLayout
        android:id="@+id/buttonsLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:weightSum="2"
        android:layout_marginBottom="16dp"
        android:gravity="center">

        <!-- Botón Pasar -->
        <Button
            android:id="@+id/btnPasar"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:text="PASAR"
            android:textColor="#FF9800"
            android:background="@drawable/button_pasar_background"
            android:layout_marginEnd="8dp"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Botón Me interesa -->
        <Button
            android:id="@+id/btnMeInteresa"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:text="ME INTERESA"
            android:textColor="#FFFFFF"
            android:background="@drawable/button_interesado_background"
            android:layout_marginStart="8dp"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

</RelativeLayout>